# Copy this file to .env if you want to override Docker Compose defaults.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nutrition_agent
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8000
FRONTEND_PORT=5173

JWT_SECRET=change-this-dev-secret
JWT_EXPIRE_MINUTES=1440

# Optional. Leave blank to use local RAG fallback mode.
OPENAI_API_KEY=

# Browser-facing URLs used when Vite builds the frontend container.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
